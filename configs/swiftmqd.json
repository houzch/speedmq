{
  "data_dir": "/var/lib/swiftmq",
  "default_vhost": "/",
  "vhosts": ["/"],
  "listeners": {
    "amqp091": [{ "addr": ":5672" }],
    "mqtt": [{ "addr": ":1883" }]
  },
  "users": {
    "guest": {
      "password": "guest",
      "tags": ["administrator"],
      "remote_access": true
    }
  },
  "storage": {
    "fsync": "os",
    "flush_interval_ms": 200,
    "memory_high_watermark": 0.4,
    "disk_free_limit": 52428800
  },
  "management": {
    "enabled": true,
    "addr": ":15672"
  },
  "cluster": {
    "enabled": false,
    "node_id": "",
    "listen": ":25672",
    "partition_policy": "pause_minority"
  },
  "plugins": {
    "amqp091": {
      "builtin": true,
      "enabled": true,
      "required": true
    },
    "mqtt": {
      "builtin": true,
      "enabled": true,
      "required": false,
      "exchange": "amq.topic",
      "max_packet_size": 8388608,
      "prefetch": 32
    },
    "echo-sidecar": {
      "builtin": false,
      "enabled": false,
      "required": false,
      "sidecar": {
        "address": "tcp://127.0.0.1:19001",
        "spawn": [],
        "restart": "always",
        "protocols": [
          {
            "name": "echo",
            "prefix": "ECHO",
            "listeners": [{ "name": "echo", "addr": ":1885" }]
          }
        ]
      }
    }
  }
}
