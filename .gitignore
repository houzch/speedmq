# ---- Go 构建产物 ----
# 本地构建的二进制（speedmqd、amqp091probe、测试二进制等）
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
# go test -c 产出的测试二进制
*.test
# 覆盖率与 profile
*.out
coverage.*
# Delve 等调试器输出
__debug_bin*

# ---- Go 本地临时目录 ----
# 部分环境把 GOTMPDIR 指到工作区内（绕开系统临时目录的执行限制）
/.gotmp/

# ---- 本地运行时数据与日志 ----
# 默认 data_dir（M4 起落盘消息与元数据）
/data/
*.log
logs/

# ---- 构建产物：一律不入库 ----
# 前端产物（web/dist）与依赖目录都不提交：仓库里只放源码，产物由 CI / Docker 构建。
# 例外：web/dist/.gitkeep 是被跟踪的**占位文件**——go:embed 在编译期必须至少匹配到一个
# 文件，没有它 `go build ./...` 会直接失败（Go 不支持"可选 embed"）。详见 web/embed.go。
dist/
node_modules/
# 先把 web/dist 目录本身放出来，再忽略其中的产物，最后放行占位文件
!web/dist/
web/dist/*
!web/dist/.gitkeep

# ---- 本地私有配置 ----
# 示例配置 configs/ 需要提交；本地覆盖请用 *.local.json / *.local.yaml
*.local.json
*.local.yaml
*.local.yml

# ---- 编辑器 / IDE ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini
AGENTS.md