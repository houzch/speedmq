{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["speedmq", "amqp", "mqtt"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "prometheus", "value": "prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "数据源",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SpeedMQ 运维总览",
  "uid": "speedmq-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "节点可达 (up)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"speedmq\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "连接数",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [ { "expr": "speedmq_connections{job=\"speedmq\"}", "refId": "A" } ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "队列数",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [ { "expr": "speedmq_queues{job=\"speedmq\"}", "refId": "A" } ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "消费者数",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [ { "expr": "speedmq_consumers{job=\"speedmq\"}", "refId": "A" } ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "资源水位阻塞生产者",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [ { "expr": "speedmq_resource_blocked{job=\"speedmq\"}", "refId": "A" } ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "插件异常个数 (plugin_up=0)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [ { "expr": "count(speedmq_plugin_up{job=\"speedmq\"} == 0) or vector(0)", "refId": "A" } ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "各队列就绪消息数 (speedmq_queue_messages_ready)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "speedmq_queue_messages_ready{job=\"speedmq\", queue=~\".+\"}", "legendFormat": "{{vhost}}/{{queue}}", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "各队列消费者数 (speedmq_queue_consumers)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "speedmq_queue_consumers{job=\"speedmq\", queue=~\".+\"}", "legendFormat": "{{vhost}}/{{queue}}", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "各队列未确认消息数 (speedmq_queue_messages_unacknowledged)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "speedmq_queue_messages_unacknowledged{job=\"speedmq\", queue=~\".+\"}", "legendFormat": "{{vhost}}/{{queue}}", "refId": "A" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "发布 / 投递 / 确认 速率（按队列，counter 的 rate）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(speedmq_queue_messages_published_total{job=\"speedmq\", queue=~\".+\"}[5m])", "legendFormat": "publish {{vhost}}/{{queue}}", "refId": "A" },
        { "expr": "rate(speedmq_queue_messages_delivered_total{job=\"speedmq\", queue=~\".+\"}[5m])", "legendFormat": "delivered {{vhost}}/{{queue}}", "refId": "B" },
        { "expr": "rate(speedmq_queue_messages_acked_total{job=\"speedmq\", queue=~\".+\"}[5m])", "legendFormat": "acked {{vhost}}/{{queue}}", "refId": "C" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "内存水位（在用内存 / 物理内存，虚线=阈值）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "speedmq_process_memory_bytes{job=\"speedmq\"} / speedmq_memory_total_bytes{job=\"speedmq\"}", "legendFormat": "在用内存占比", "refId": "A" },
        { "expr": "speedmq_memory_high_watermark{job=\"speedmq\"}", "legendFormat": "内存水位阈值", "refId": "B" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "磁盘可用空间 vs 下限（字节）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "speedmq_disk_free_bytes{job=\"speedmq\"}", "legendFormat": "数据目录可用", "refId": "A" },
        { "expr": "speedmq_disk_free_limit_bytes{job=\"speedmq\"}", "legendFormat": "磁盘下限", "refId": "B" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "插件状态 (speedmq_plugin_up)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "speedmq_plugin_up{job=\"speedmq\"}", "legendFormat": "{{name}} ({{state}})", "refId": "A" }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "各队列内存占用估算 (speedmq_queue_memory_bytes)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "speedmq_queue_memory_bytes{job=\"speedmq\", queue=~\".+\"}", "legendFormat": "{{vhost}}/{{queue}}", "refId": "A" }
      ]
    }
  ]
}
