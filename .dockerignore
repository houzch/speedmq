# 构建上下文裁剪：只保留编译内核与构建前端所需的源码

# 本地构建产物
bin/
*.exe
*.test

# Go 临时目录（本机 go test 的临时编译目录）
.gotmp/

# 集成测试是独立 module（含第三方客户端依赖），不参与镜像构建
test/

# 管理 UI：依赖目录与产物都不进上下文——
# 依赖由镜像内的前端构建阶段 `npm ci` 安装；
# 产物由该阶段 `npm run build` 生成后再 COPY 给 Go 构建阶段，
# 避免把本机 node_modules（体积大、平台相关）与旧产物带进镜像。
node_modules/
web/node_modules/
web/dist/

# 版本控制与编辑器
.git/
.gitignore
.idea/
.vscode/

# 本地配置与日志
*.log
data/
